  "reports": [
    {
      "name": "ETC_Polizas_Por_Ramo",
      "label": "Pólizas por ramo",
      "description": "Pólizas agrupadas por ramo con prima total.",
      "type": "ETC_Polizas__c",
      "scope": "organization",
      "columns": [
        "InsurancePolicy$Name",
        "InsurancePolicy$PolicyName",
        "InsurancePolicy$Status",
        [
          "InsurancePolicy$PremiumAmount",
          "Sum"
        ],
        "InsurancePolicy$ExpirationDate"
      ],
      "groups": [
        "InsurancePolicy$ETC_Ramo__c"
      ],
      "time": [
        "InsurancePolicy$CreatedDate"
      ],
      "chart": [
        "Donut",
        "InsurancePolicy$ETC_Ramo__c",
        {
          "col": "RowCount"
        }
      ],
      "catalog": "INS-012"
    },
    {
      "name": "ETC_Polizas_Por_Vencer",
      "label": "Pólizas por vencer (30 días)",
      "description": "Pólizas con fin de vigencia en los próximos 30 días.",
      "type": "ETC_Polizas__c",
      "scope": "organization",
      "columns": [
        "InsurancePolicy$Name",
        "InsurancePolicy$PolicyName",
        "InsurancePolicy$ETC_Ramo__c",
        "InsurancePolicy$ExpirationDate"
      ],
      "groups": [
        "InsurancePolicy$ETC_Aseguradora__c"
      ],
      "time": [
        "InsurancePolicy$ExpirationDate",
        "INTERVAL_NEXT30"
      ],
      "chart": [
        "HorizontalBar",
        "InsurancePolicy$ETC_Aseguradora__c",
        {
          "col": "RowCount"
        }
      ],
      "catalog": "INS-007"
    },
    {
      "name": "ETC_Siniestros_Por_Estado",
