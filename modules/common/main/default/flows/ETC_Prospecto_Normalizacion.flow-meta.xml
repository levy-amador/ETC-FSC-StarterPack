<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Normalizar</name>
        <label>Normalizar RFC</label>
        <locationX>0</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>$Record.ETC_RFC__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxRFC</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Before-save: normaliza el RFC del prospecto a mayúsculas sin espacios ni guiones.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxRFC</name>
        <dataType>String</dataType>
        <expression>UPPER(SUBSTITUTE(SUBSTITUTE(TRIM({!$Record.ETC_RFC__c}), &quot; &quot;, &quot;&quot;), &quot;-&quot;, &quot;&quot;))</expression>
    </formulas>
    <interviewLabel>ETC Prospecto · normalización {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ETC Prospecto · normalización</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Normalizar</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.ETC_RFC__c}))</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
