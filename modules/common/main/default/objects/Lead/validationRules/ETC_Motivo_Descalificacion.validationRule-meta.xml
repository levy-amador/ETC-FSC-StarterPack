<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ETC_Motivo_Descalificacion</fullName>
    <active>true</active>
    <description>Prospecto descalificado requiere motivo</description>
    <errorConditionFormula>AND(ISPICKVAL(Status, &quot;Unqualified&quot;), ISBLANK(TEXT(ETC_Motivo_Descalificacion__c)))</errorConditionFormula>
    <errorMessage>Indica el motivo de descalificación.</errorMessage>
</ValidationRule>
