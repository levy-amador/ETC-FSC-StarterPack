<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ETC_CLABE_Formato</fullName>
    <active>true</active>
    <description>CLABE de 18 dígitos</description>
    <errorConditionFormula>AND(NOT(ISBLANK(ETC_CLABE__c)), NOT(REGEX(ETC_CLABE__c, &quot;[0-9]{18}&quot;)))</errorConditionFormula>
    <errorMessage>La CLABE debe tener 18 dígitos.</errorMessage>
</ValidationRule>
