<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Asignar_Cierre</name>
        <label>Asignar fecha de cierre</label>
        <locationX>0</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>$Record.ClosingDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Before-save: si la cuenta pasa a Closed sin fecha de cierre, registra la fecha de hoy.</description>
    <environments>Default</environments>
    <interviewLabel>ETC Cuenta financiera · fecha de cierre {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ETC Cuenta financiera · fecha de cierre</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Asignar_Cierre</targetReference>
        </connector>
        <filterFormula>AND(ISPICKVAL({!$Record.Status}, &quot;Closed&quot;), ISBLANK({!$Record.ClosingDate}))</filterFormula>
        <object>FinancialAccount</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
